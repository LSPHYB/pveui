# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，不要提交

# --- 数据库 ---
# DB_HOST/DB_PORT 由 compose 注入（指向 mysql 服务），此处无需配置
DB_NAME=pve
DB_USER=pve
DB_PASSWORD=
# MySQL root 密码，仅容器内部使用
MYSQL_ROOT_PASSWORD=

# --- Django ---
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False

# 逗号分隔的允许主机名，生产环境应收紧为实际域名/IP
ALLOWED_HOSTS=*

# 经 Nginx 同源反代访问时可设为 false
CORS_ALLOW_ALL=true
# CORS_ALLOW_ALL=false 时生效，逗号分隔的允许来源（含协议与端口）
CORS_ALLOWED_ORIGINS=

# --- 初始超级管理员（仅首次创建，之后改密码不受影响）---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- 可选：Channels 使用 Redis（留空则用内存 Channel Layer，仅适合单进程）---
REDIS_URL=

# --- 端口映射 ---
BACKEND_PORT=8000
FRONTEND_PORT=2208
# MySQL 仅绑定 127.0.0.1，供本地开发连接
MYSQL_PORT=3306
